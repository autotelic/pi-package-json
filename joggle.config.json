{
  "rules": {
    "joggle/import-cycle": "error",
    "joggle/layer-direction": "error",
    "joggle/layer-purity": "error",
    "joggle/field-type-drift": "warn",
    "joggle/duplicate-meaning": "warn",
    "joggle/naming-drift": "warn",
    "joggle/module-direction": "warn",
    "joggle/hoist-to-domain": "warn",
    "joggle/unaccounted-drop": "warn",
    "joggle/meaning-switched-by-flag": "warn",
    "joggle/generic-carries-a-caller": "warn",
    "joggle/single-path": "warn"
  },
  "unavailable": "count",
  "architecture": {
    "layers": [
      {
        "name": "kernel",
        "include": [
          "extensions/types.ts",
          "extensions/text.ts",
          "extensions/clock.ts",
          "extensions/schema.ts",
          "extensions/details.ts",
          "extensions/revision.ts"
        ]
      },
      {
        "name": "domain",
        "include": [
          "extensions/config.ts",
          "extensions/naming.ts",
          "extensions/ignore.ts",
          "extensions/delegate.ts"
        ]
      },
      {
        "name": "engine",
        "include": [
          "extensions/discover.ts",
          "extensions/exec.ts",
          "extensions/tool.ts",
          "extensions/report.ts"
        ]
      },
      {
        "name": "entry",
        "include": [
          "extensions/index.ts"
        ]
      }
    ]
  },
  "evidence": {
    "repository": "A Pi extension: a Node program that runs inside the Pi process and registers one pi tool for every package.json script under the directory pi was launched in. It renders no components and depends on no Effect runtime, so the composition and effect rule families are not enabled here."
  }
}
