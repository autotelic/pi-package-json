{
  "name": "pi-package-json",
  "version": "0.1.0",
  "type": "module",
  "description": "Pi extension that turns every package.json script in a monorepo into a named pi tool.",
  "license": "MIT",
  "packageManager": "pnpm@12.3.4",
  "homepage": "https://github.com/autotelic/pi-package-json#readme",
  "bugs": {
    "url": "https://github.com/autotelic/pi-package-json/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": ["pi-package", "pi-extension", "monorepo", "package-json", "scripts"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/autotelic/pi-package-json.git"
  },
  "pi": {
    "extensions": ["./extensions/package-scripts/index.ts"]
  },
  "files": ["extensions", "README.md"],
  "scripts": {
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "joggle": "node --conditions=development ${JOGGLE_ENTRY:-../mess/src/main.ts} check .",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm joggle"
  },
  "devDependencies": {
    "@autotelic/plumb": "^0.6.0",
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@types/node": "^24.0.0",
    "oxlint": "^1.85.0",
    "typebox": "^1.3.8",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
